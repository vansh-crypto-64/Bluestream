rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Platform Owner / Admin check (strictly requires verified email or admins collection doc)
    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token &&
         'email_verified' in request.auth.token &&
         request.auth.token.email == 'lakeskuke@gmail.com' &&
         request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidCategory(cat) {
      return cat in ['Tech', 'Music', 'Gaming', 'Travel', 'Education', 'Vlogs', 'Sports', 'Shorts'];
    }

    function isValidVisibility(vis) {
      return vis in ['public', 'private'];
    }

    function isValidModerationStatus(status) {
      return status in ['pending', 'approved', 'rejected'];
    }

    function isValidReportStatus(status) {
      return status in ['open', 'resolved', 'dismissed'];
    }

    function isValidChannel(data) {
      return data.ownerId is string && isValidId(data.ownerId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 36 &&
             data.bio is string && data.bio.size() <= 300 &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             data.subscriberCount is int && data.subscriberCount >= 0 &&
             data.videoCount is int && data.videoCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVideo(data) {
      return data.ownerId is string && isValidId(data.ownerId) &&
             data.channelName is string && data.channelName.size() >= 1 && data.channelName.size() <= 60 &&
             data.channelHandle is string && data.channelHandle.size() >= 1 && data.channelHandle.size() <= 36 &&
             (!('channelAvatarUrl' in data) || data.channelAvatarUrl == null || (data.channelAvatarUrl is string && data.channelAvatarUrl.size() <= 500)) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 2000 &&
             data.category is string && isValidCategory(data.category) &&
             data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 1500 &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1500)) &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 43200 &&
             data.visibility is string && isValidVisibility(data.visibility) &&
             data.moderationStatus is string && isValidModerationStatus(data.moderationStatus) &&
             data.featured is bool &&
             data.viewsCount is int && data.viewsCount >= 0 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVideoReport(data) {
      return data.videoId is string && isValidId(data.videoId) &&
             data.videoTitle is string && data.videoTitle.size() >= 1 && data.videoTitle.size() <= 120 &&
             data.videoOwnerId is string && isValidId(data.videoOwnerId) &&
             data.reporterId is string && isValidId(data.reporterId) &&
             data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 100 &&
             (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 500)) &&
             data.status is string && isValidReportStatus(data.status) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidComment(data) {
      return data.videoId is string && isValidId(data.videoId) &&
             data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             (!('authorAvatarUrl' in data) || data.authorAvatarUrl == null || (data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 500)) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 600 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserLike(data) {
      return data.videoId is string && isValidId(data.videoId) &&
             data.videoTitle is string && data.videoTitle.size() >= 1 && data.videoTitle.size() <= 120 &&
             data.channelName is string && data.channelName.size() >= 1 && data.channelName.size() <= 60 &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserSubscription(data) {
      return data.channelId is string && isValidId(data.channelId) &&
             data.channelName is string && data.channelName.size() >= 1 && data.channelName.size() <= 60 &&
             data.channelHandle is string && data.channelHandle.size() >= 1 && data.channelHandle.size() <= 36 &&
             (!('channelAvatarUrl' in data) || data.channelAvatarUrl == null || (data.channelAvatarUrl is string && data.channelAvatarUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidWatchLater(data) {
      return data.videoId is string && isValidId(data.videoId) &&
             data.videoTitle is string && data.videoTitle.size() >= 1 && data.videoTitle.size() <= 120 &&
             data.channelName is string && data.channelName.size() >= 1 && data.channelName.size() <= 60 &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1500)) &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 43200 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- CHANNELS COLLECTION ---
    match /channels/{channelId} {
      allow get: if isSignedIn() && isValidId(channelId);
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(channelId) &&
                       request.auth.uid == channelId &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['ownerId', 'displayName', 'handle', 'bio', 'subscriberCount', 'videoCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'displayName', 'handle', 'bio', 'avatarUrl', 'subscriberCount', 'videoCount', 'createdAt', 'updatedAt']) &&
                       incoming().subscriberCount == 0 &&
                       incoming().videoCount == 0 &&
                       isValidChannel(incoming());

      allow update: if isSignedIn() &&
                       isValidId(channelId) &&
                       isValidChannel(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Owner or Admin profile & videoCount update
                         ((request.auth.uid == channelId || isAdmin()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'bio', 'avatarUrl', 'videoCount', 'updatedAt'])) ||
                         // Action 2: Subscriber count increment/decrement (+/- 1)
                         (incoming().diff(existing()).affectedKeys().hasOnly(['subscriberCount', 'updatedAt']) &&
                          (incoming().subscriberCount == existing().subscriberCount + 1 ||
                           incoming().subscriberCount == existing().subscriberCount - 1))
                       );

      allow delete: if isSignedIn() && isValidId(channelId) && (request.auth.uid == channelId || isAdmin());
    }

    // --- VIDEOS COLLECTION ---
    match /videos/{videoId} {
      allow get: if isSignedIn() && isValidId(videoId) && (
        (existing().visibility == 'public' && existing().moderationStatus == 'approved') ||
        existing().ownerId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        (resource.data.visibility == 'public' && resource.data.moderationStatus == 'approved') ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(videoId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['ownerId', 'channelName', 'channelHandle', 'title', 'description', 'category', 'videoUrl', 'durationSeconds', 'visibility', 'moderationStatus', 'featured', 'viewsCount', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'channelName', 'channelHandle', 'channelAvatarUrl', 'title', 'description', 'category', 'videoUrl', 'thumbnailUrl', 'durationSeconds', 'visibility', 'moderationStatus', 'featured', 'viewsCount', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt']) &&
                       (incoming().featured == false || isAdmin()) &&
                       (incoming().moderationStatus == 'pending' || isAdmin()) &&
                       incoming().viewsCount == 0 &&
                       incoming().likesCount == 0 &&
                       incoming().commentsCount == 0 &&
                       isValidVideo(incoming());

      allow update: if isSignedIn() &&
                       isValidId(videoId) &&
                       isValidVideo(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Platform Owner/Admin moderation (approve/reject/feature/edit)
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'visibility', 'moderationStatus', 'featured', 'thumbnailUrl', 'updatedAt'])) ||
                         // Action 2: Creator edit metadata (cannot self-approve or feature)
                         (existing().ownerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'visibility', 'thumbnailUrl', 'updatedAt'])) ||
                         // Action 3: Increment view count (+1) on approved public video
                         (existing().visibility == 'public' && existing().moderationStatus == 'approved' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']) &&
                          incoming().viewsCount == existing().viewsCount + 1) ||
                         // Action 4: Toggle like count (+/- 1) on approved public video
                         (existing().visibility == 'public' && existing().moderationStatus == 'approved' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) &&
                          (incoming().likesCount == existing().likesCount + 1 ||
                           incoming().likesCount == existing().likesCount - 1)) ||
                         // Action 5: Sync comment count (+/- 1) on approved public video
                         (existing().visibility == 'public' && existing().moderationStatus == 'approved' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount']) &&
                          (incoming().commentsCount == existing().commentsCount + 1 ||
                           incoming().commentsCount == existing().commentsCount - 1))
                       );

      allow delete: if isSignedIn() && isValidId(videoId) && (existing().ownerId == request.auth.uid || isAdmin());

      // --- VIDEO COMMENTS SUBCOLLECTION ---
      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(videoId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(videoId) && resource.data.videoId == videoId;

        allow create: if isSignedIn() &&
                         isValidId(videoId) &&
                         isValidId(commentId) &&
                         incoming().authorId == request.auth.uid &&
                         incoming().videoId == videoId &&
                         incoming().keys().hasAll(['videoId', 'authorId', 'authorName', 'text', 'likesCount', 'createdAt']) &&
                         incoming().keys().hasOnly(['videoId', 'authorId', 'authorName', 'authorAvatarUrl', 'text', 'likesCount', 'createdAt']) &&
                         incoming().likesCount == 0 &&
                         isValidComment(incoming()) &&
                         exists(/databases/$(database)/documents/videos/$(videoId));

        allow update: if isSignedIn() &&
                         isValidId(videoId) &&
                         isValidId(commentId) &&
                         isValidComment(incoming()) &&
                         incoming().authorId == existing().authorId &&
                         incoming().videoId == existing().videoId &&
                         incoming().createdAt == existing().createdAt && (
                           (existing().authorId == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['text'])) ||
                           (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) &&
                            (incoming().likesCount == existing().likesCount + 1 ||
                             incoming().likesCount == existing().likesCount - 1))
                         );

        allow delete: if isSignedIn() && isValidId(videoId) && isValidId(commentId) && (
          existing().authorId == request.auth.uid || isAdmin()
        );
      }
    }

    // --- VIDEO REPORTS COLLECTION ---
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (
        existing().reporterId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid || isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().keys().hasAll(['videoId', 'videoTitle', 'videoOwnerId', 'reporterId', 'reason', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['videoId', 'videoTitle', 'videoOwnerId', 'reporterId', 'reason', 'details', 'status', 'createdAt', 'updatedAt']) &&
                       isValidVideoReport(incoming()) &&
                       exists(/databases/$(database)/documents/videos/$(incoming().videoId));

      allow update: if isAdmin() &&
                       isValidId(reportId) &&
                       isValidVideoReport(incoming()) &&
                       incoming().videoId == existing().videoId &&
                       incoming().reporterId == existing().reporterId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(reportId);
    }

    // --- USER-SCOPED INTERACTION SUBCOLLECTIONS ---
    match /users/{userId}/likes/{videoId} {
      allow get: if isOwner(userId) && isValidId(videoId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(videoId) &&
                       incoming().videoId == videoId &&
                       incoming().keys().hasAll(['videoId', 'videoTitle', 'channelName', 'createdAt']) &&
                       incoming().keys().hasOnly(['videoId', 'videoTitle', 'channelName', 'thumbnailUrl', 'createdAt']) &&
                       isValidUserLike(incoming());
      allow delete: if isOwner(userId) && isValidId(videoId);
    }

    match /users/{userId}/subscriptions/{channelId} {
      allow get: if isOwner(userId) && isValidId(channelId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(channelId) &&
                       incoming().channelId == channelId &&
                       incoming().keys().hasAll(['channelId', 'channelName', 'channelHandle', 'createdAt']) &&
                       incoming().keys().hasOnly(['channelId', 'channelName', 'channelHandle', 'channelAvatarUrl', 'createdAt']) &&
                       isValidUserSubscription(incoming());
      allow delete: if isOwner(userId) && isValidId(channelId);
    }

    match /users/{userId}/watch_later/{videoId} {
      allow get: if isOwner(userId) && isValidId(videoId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(videoId) &&
                       incoming().videoId == videoId &&
                       incoming().keys().hasAll(['videoId', 'videoTitle', 'channelName', 'durationSeconds', 'createdAt']) &&
                       incoming().keys().hasOnly(['videoId', 'videoTitle', 'channelName', 'thumbnailUrl', 'durationSeconds', 'createdAt']) &&
                       isValidWatchLater(incoming());
      allow delete: if isOwner(userId) && isValidId(videoId);
    }
  }
}

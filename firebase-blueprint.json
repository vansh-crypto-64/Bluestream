{
  "entities": {
    "Channel": {
      "title": "Channel",
      "description": "Public creator channel profile (PII-free).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the channel owner."
        },
        "displayName": {
          "type": "string",
          "description": "Public channel display name (1..60 chars)."
        },
        "handle": {
          "type": "string",
          "description": "Channel handle starting with @ (2..32 chars)."
        },
        "bio": {
          "type": "string",
          "description": "Channel bio/about text (0..300 chars)."
        },
        "avatarUrl": {
          "type": "string",
          "description": "Optional avatar photo URL (0..500 chars)."
        },
        "subscriberCount": {
          "type": "integer",
          "description": "Total subscriber count (>= 0)."
        },
        "videoCount": {
          "type": "integer",
          "description": "Total uploaded video count (>= 0)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp written with FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp written with FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "handle",
        "bio",
        "subscriberCount",
        "videoCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Video": {
      "title": "Video",
      "description": "Uploaded social video entry in BlueStream.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the video creator."
        },
        "channelName": {
          "type": "string",
          "description": "Denormalized channel display name (1..60 chars)."
        },
        "channelHandle": {
          "type": "string",
          "description": "Denormalized channel handle (1..36 chars)."
        },
        "channelAvatarUrl": {
          "type": "string",
          "description": "Optional channel avatar URL (0..500 chars)."
        },
        "title": {
          "type": "string",
          "description": "Video title (1..120 chars)."
        },
        "description": {
          "type": "string",
          "description": "Video description (0..2000 chars)."
        },
        "category": {
          "type": "string",
          "enum": ["Tech", "Music", "Gaming", "Travel", "Education", "Vlogs", "Sports", "Shorts"],
          "description": "Video category."
        },
        "videoUrl": {
          "type": "string",
          "description": "Playable video stream URL or device file URI (1..1000 chars)."
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Optional thumbnail URL, local file URI, or preset key (0..1000 chars)."
        },
        "durationSeconds": {
          "type": "integer",
          "description": "Video duration in seconds (0..43200)."
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Visibility of the video."
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the platform owner featured this video."
        },
        "viewsCount": {
          "type": "integer",
          "description": "Total views (>= 0)."
        },
        "likesCount": {
          "type": "integer",
          "description": "Total likes (>= 0)."
        },
        "commentsCount": {
          "type": "integer",
          "description": "Total comments (>= 0)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp written with FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp written with FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "ownerId",
        "channelName",
        "channelHandle",
        "title",
        "description",
        "category",
        "videoUrl",
        "durationSeconds",
        "visibility",
        "featured",
        "viewsCount",
        "likesCount",
        "commentsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment on a video.",
      "type": "object",
      "properties": {
        "videoId": {
          "type": "string",
          "description": "Parent video document ID."
        },
        "authorId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the commenter."
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the commenter (1..60 chars)."
        },
        "authorAvatarUrl": {
          "type": "string",
          "description": "Optional commenter avatar URL (0..500 chars)."
        },
        "text": {
          "type": "string",
          "description": "Comment body text (1..600 chars)."
        },
        "likesCount": {
          "type": "integer",
          "description": "Comment likes (>= 0)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp written with FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "videoId",
        "authorId",
        "authorName",
        "text",
        "likesCount",
        "createdAt"
      ]
    },
    "UserLike": {
      "title": "UserLike",
      "description": "Tracks a video liked by a specific user.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "channelName": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Written with FieldValue.serverTimestamp()."
        }
      },
      "required": ["videoId", "videoTitle", "channelName", "createdAt"]
    },
    "UserSubscription": {
      "title": "UserSubscription",
      "description": "Tracks a channel subscription for a specific user.",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "channelName": { "type": "string" },
        "channelHandle": { "type": "string" },
        "channelAvatarUrl": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Written with FieldValue.serverTimestamp()."
        }
      },
      "required": ["channelId", "channelName", "channelHandle", "createdAt"]
    },
    "WatchLaterItem": {
      "title": "WatchLaterItem",
      "description": "Tracks a video saved to Watch Later by a user.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "channelName": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "durationSeconds": { "type": "integer" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Written with FieldValue.serverTimestamp()."
        }
      },
      "required": ["videoId", "videoTitle", "channelName", "durationSeconds", "createdAt"]
    }
  },
  "firestore": {
    "/channels/{channelId}": {
      "schema": { "$ref": "#/entities/Channel" },
      "description": "Public creator channel profiles keyed by owner UID."
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "#/entities/Video" },
      "description": "Social video catalog supporting public feed, private drafts, and owner moderation."
    },
    "/videos/{videoId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments posted under a specific video."
    },
    "/users/{userId}/likes/{videoId}": {
      "schema": { "$ref": "#/entities/UserLike" },
      "description": "Per-user liked videos keyed by videoId."
    },
    "/users/{userId}/subscriptions/{channelId}": {
      "schema": { "$ref": "#/entities/UserSubscription" },
      "description": "Per-user channel subscriptions keyed by channelId."
    },
    "/users/{userId}/watch_later/{videoId}": {
      "schema": { "$ref": "#/entities/WatchLaterItem" },
      "description": "Per-user saved Watch Later queue keyed by videoId."
    }
  }
}

{
  "entities": {
    "Channel": {
      "title": "Channel",
      "description": "Public creator channel profile (PII-free).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "displayName": { "type": "string" },
        "handle": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "subscriberCount": { "type": "integer" },
        "videoCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "displayName",
        "handle",
        "bio",
        "subscriberCount",
        "videoCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Video": {
      "title": "Video",
      "description": "Uploaded online video entry with moderation workflow.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "channelName": { "type": "string" },
        "channelHandle": { "type": "string" },
        "channelAvatarUrl": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["Tech", "Music", "Gaming", "Travel", "Education", "Vlogs", "Sports", "Shorts"]
        },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "durationSeconds": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "moderationStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "featured": { "type": "boolean" },
        "viewsCount": { "type": "integer" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "channelName",
        "channelHandle",
        "title",
        "description",
        "category",
        "videoUrl",
        "durationSeconds",
        "visibility",
        "moderationStatus",
        "featured",
        "viewsCount",
        "likesCount",
        "commentsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "VideoReport": {
      "title": "VideoReport",
      "description": "User-submitted report flagging a video for owner moderation.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "videoOwnerId": { "type": "string" },
        "reporterId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "videoId",
        "videoTitle",
        "videoOwnerId",
        "reporterId",
        "reason",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment on a video.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatarUrl": { "type": "string" },
        "text": { "type": "string" },
        "likesCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "authorId", "authorName", "text", "likesCount", "createdAt"]
    },
    "UserLike": {
      "title": "UserLike",
      "description": "Tracks a video liked by a specific user.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "channelName": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "videoTitle", "channelName", "createdAt"]
    },
    "UserSubscription": {
      "title": "UserSubscription",
      "description": "Tracks a channel subscription for a specific user.",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "channelName": { "type": "string" },
        "channelHandle": { "type": "string" },
        "channelAvatarUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "channelName", "channelHandle", "createdAt"]
    },
    "WatchLaterItem": {
      "title": "WatchLaterItem",
      "description": "Tracks a video saved to Watch Later by a user.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "channelName": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "durationSeconds": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "videoTitle", "channelName", "durationSeconds", "createdAt"]
    }
  },
  "firestore": {
    "/channels/{channelId}": {
      "schema": { "$ref": "#/entities/Channel" },
      "description": "Public creator channel profiles keyed by owner UID."
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "#/entities/Video" },
      "description": "Online video catalog with moderationStatus approval before public feed publishing."
    },
    "/videos/{videoId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments posted under a specific video."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/VideoReport" },
      "description": "User video reports for owner review and moderation."
    },
    "/users/{userId}/likes/{videoId}": {
      "schema": { "$ref": "#/entities/UserLike" },
      "description": "Per-user liked videos keyed by videoId."
    },
    "/users/{userId}/subscriptions/{channelId}": {
      "schema": { "$ref": "#/entities/UserSubscription" },
      "description": "Per-user channel subscriptions keyed by channelId."
    },
    "/users/{userId}/watch_later/{videoId}": {
      "schema": { "$ref": "#/entities/WatchLaterItem" },
      "description": "Per-user saved Watch Later queue keyed by videoId."
    }
  }
}
